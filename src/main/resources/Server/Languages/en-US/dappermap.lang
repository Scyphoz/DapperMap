# === tabs ===

tab.display = DISPLAY
tab.display.desc = Choose how the minimap looks and how hard it works.
tab.markers = MARKERS
tab.markers.desc = Choose the navigation markers shown on your minimap.
tab.integrations = INTEGRATIONS
tab.integrations.desc = Connect Hytale and BetterMap map features to your minimap.
tab.interface = INFO PANEL
tab.interface.desc = Choose what the Info Panel shows and where it sits.
tab.position = POSITION
tab.position.desc = Place the minimap on-screen and fine-tune its position.
tab.colours = COLOURS
tab.colours.desc = Tune the DapperMap palette and preview every change live.
tab.server = SERVER LIMITS
tab.server.desc = Cap the most expensive settings for every player and set server-wide image options. Saved player choices are kept.

# === setting rows (row.<id> = label, row.<id>.desc = description; upper-case rows are section headers) ===

row.enabled = Minimap
row.enabled.desc = Show or hide your minimap.
row.section_0 = MAP APPEARANCE
row.zoom = Zoom Radius
row.zoom.desc = Choose how far around you the map shows.
row.size = Map Size
row.size.desc = Change the size of the map on your screen. Markers grow with larger maps.
row.interface_scale = Interface Scale
row.interface_scale.desc = Resize the map and its information together.
row.shape = Map Shape
row.shape.desc = Choose a round or square map.
row.rotation = Map Rotation
row.rotation.desc = Keep north at the top, or turn the map with the direction you face.
row.section_compass = COMPASS RING
row.compass_letters = Compass Letters
row.compass_letters.desc = Show the N, E, S and W letters around the map edge.
row.compass_dashes = Compass Dashes
row.compass_dashes.desc = Show the small dashes around the map edge.
row.cardinal_dashes = Cardinal Dashes
row.cardinal_dashes.desc = Show the large N, E, S and W dashes. When hidden, the letters take their place.
row.section_font = FONT SIZE
row.font_area = Text
row.font_area.desc = Choose which text the size slider changes.
row.font_size = Size
row.font_size.desc = Left for smaller text, right for larger. The middle is the standard size.
row.section_performance = PERFORMANCE
row.speed = Update Speed
row.speed.desc = How often the minimap refreshes. Faster uses more server work.
row.texture_resolution = Texture Resolution
row.texture_resolution.desc = Sharper map detail. Higher values use more server work and data.
row.section_limits = PLAYER SETTING LIMITS
row.limit_speed = Fastest Update Speed
row.limit_speed.desc = Fastest update speed any player's minimap runs at.
row.limit_resolution = Max Texture Resolution
row.limit_resolution.desc = Highest texture resolution any player's minimap renders at.
row.limit_zoom = Max Zoom Radius
row.limit_zoom.desc = Largest zoom radius any player's minimap can show.
row.limit_creatures = Max Creature Markers
row.limit_creatures.desc = Most creature markers any player's minimap shows.
row.section_terrain_images = TERRAIN IMAGES
row.terrain_colours = Terrain Colour Reduction
row.terrain_colours.desc = Fewer colours make smaller terrain images (less data sent to players) but can shift map colours. Off sends exact colours.
row.info_panel = Info Panel
row.info_panel.desc = Show or hide the Info Panel while keeping the minimap visible.
row.panel_position = Info Panel Position
row.panel_position.desc = Choose which side of the map the Info Panel sits on.
row.panel_alignment = Info Panel Alignment
row.panel_alignment.desc = Align the Info Panel text left, centre or right.
row.section_players = PLAYERS
row.players = Player Markers
row.players.desc = Show nearby players on your minimap.
row.player_style = Player Marker Style
row.player_style.desc = Show players as head icons or as dots.
row.player_helmets = Player Icon Helmets
row.player_helmets.desc = Show the helmet each player wears on their icon.
row.section_creatures = CREATURES
row.entities = Creature Markers
row.entities.desc = Show nearby creatures on your minimap.
row.creature_style = Creature Marker Style
row.creature_style.desc = Show creatures as face icons or as threat-coloured dots.
row.creature_filter = Creature Filter
row.creature_filter.desc = Show all creatures, or only hostile and attacking ones.
row.creature_limit = Creature Marker Limit
row.creature_limit.desc = Show up to 16, 32 or 64 nearby creatures, prioritising the nearest.
row.height = Creature Height Filter
row.height.desc = Hide creatures far above or below you.
row.vrange = Height Filter Range
row.vrange.desc = How far above and below you creatures are shown.
row.critters = Critter Markers
row.critters.desc = Hide harmless ground critters (mice, frogs), flying critters (birds, bats), or both.
row.memories = Uncollected Memories
row.memories.desc = Slowly flash creatures that still have a memory for you to collect.
row.section_other = OTHER
row.death = Death Markers
row.death.desc = Show death markers on your minimap.
row.section_marker_size = MARKER SIZE
row.marker_area = Marker Type
row.marker_area.desc = Choose which markers the size slider changes.
row.marker_size = Size
row.marker_size.desc = Left for smaller markers, right for larger. The middle is the standard size.
row.section_3 = INFORMATION
row.coordinates = Coordinates
row.coordinates.desc = Show your current world coordinates.
row.compass = Bearing
row.compass.desc = Show the direction you are facing.
row.clock = World Time
row.clock.desc = Show the current time in your Hytale world.
row.clock_format = Clock Format
row.clock_format.desc = Choose a 12-hour or 24-hour clock.
row.biome = Region
row.biome.desc = Show the name of the region you are in.
row.section_4 = HYTALE
row.worldmap = Hytale World Map Markers
row.worldmap.desc = Show Hytale personal, shared, POI, spawn and respawn world-map markers.
row.section_5 = BETTERMAP
row.bettermap = BetterMap
row.bettermap.desc = Use BetterMap's waypoints and cave maps on your minimap.
row.bettermap_markers = BetterMap Markers
row.bettermap_markers.desc = Show waypoints with BetterMap icons. When off, they appear with Hytale map markers.
row.bettermap_caves = BetterMap Cave Mode
row.bettermap_caves.desc = Show BetterMap's cave terrain while underground.
row.disabled = Disabled
row.bettermap.missing = BetterMap is not installed or could not be detected.
