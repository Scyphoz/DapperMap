$C = "../Common.ui";

Group {
  Anchor: (Height: 64);
  Background: #16182b(0.94);
  LayoutMode: Left;
  Padding: (Horizontal: 10, Vertical: 8);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #57d8d0;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 14, Right: 10);

    Label #RowLabel {
      Anchor: (Height: 23);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f2ff,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 11, TextColor: #8e9bb2, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;
  }
}
