$C = "../Common.ui";
Group { Anchor: (Height: 42); LayoutMode: Left; Padding: (Left: 2, Right: 2, Vertical: 4);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { Anchor: (Width: 180); LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 34); Style: (FontSize: 10, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 0); Visible: false; }
  }
  Group { FlexWeight: 1; }
  // The stock dropdown macro has a wide intrinsic size. A fixed parent with a
  // full anchor constrains the actual rendered control, not only the row slot.
  Group #ValueFrame { Anchor: (Width: 170, Height: 34); LayoutMode: Full;
    $C.@DropdownBox #ValueDropdown { @Anchor = (Full: 0); ShowLabel: true; }
  }
}
