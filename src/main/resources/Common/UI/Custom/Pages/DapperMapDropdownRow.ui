$C = "../Common.ui";
// Two columns: label and description (left), control column (right), split 5:3 by FlexWeight,
// so the control column is always 3/8 of the settings column and resizes with it.
Group { Anchor: (Height: 66); LayoutMode: Left; Padding: (Left: 2, Right: 2, Top: 6, Bottom: 6);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { FlexWeight: 5; LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 20); Style: (FontSize: 14, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 32); Style: (FontSize: 11, Wrap: true, TextColor: #9298ae, HorizontalAlignment: Start, VerticalAlignment: Start); }
  }
  Group { Anchor: (Width: 12); }
  // The dropdown fills the control column (and its list opens at the same width). The stock
  // dropdown macro has a wide intrinsic size, so a parent with a full anchor constrains it.
  Group #ControlColumn { FlexWeight: 3; LayoutMode: Top;
    Group { FlexWeight: 1; }
    Group #ValueFrame { Anchor: (Height: 34); LayoutMode: Full;
      $C.@DropdownBox #ValueDropdown { @Anchor = (Full: 0); ShowLabel: true; }
    }
    Group { FlexWeight: 1; }
  }
}
