$C = "../Common.ui";

Group {
  Anchor: (Height: 58);
  Background: #132331(0.96);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 4, Height: 42);
    Background: #9ddcff;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f7fb,
        VerticalAlignment: Center
      );
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;
  }
}
