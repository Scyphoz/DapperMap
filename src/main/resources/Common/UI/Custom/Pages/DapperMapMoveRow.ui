Group {
  Anchor: (Height: 62);
  Background: PatchStyle(TexturePath: "DapperMapGlassRow.png", Border: 10);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #f4c76b;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 14, Right: 10);

    Label #RowLabel {
      Text: "Screen Position";
      Anchor: (Height: 23);
      Style: (FontSize: 14, RenderBold: true, TextColor: #d9d0f5, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 10, TextColor: #9997b1, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #BtnSlot {
    Anchor: (Width: 230, Height: 38);
    LayoutMode: CenterMiddle;
  }
}
