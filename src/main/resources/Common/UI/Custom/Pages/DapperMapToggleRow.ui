Group {
  Anchor: (Height: 58);
  Background: #132331(0.96);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 4, Height: 42);
    Background: #ffd66b;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 23);
      Style: (FontSize: 15, RenderBold: true, TextColor: #f4f7fb, HorizontalAlignment: Start, VerticalAlignment: Center);
    }

    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 11, TextColor: #9ddcff, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #BtnSlot {
    Anchor: (Width: 132, Height: 38);
    LayoutMode: CenterMiddle;
  }
}
