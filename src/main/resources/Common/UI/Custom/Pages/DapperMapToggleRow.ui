Group { Anchor: (Height: 66); LayoutMode: Left; Padding: (Left: 2, Right: 2, Top: 6, Bottom: 6);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { FlexWeight: 1; LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 20); Style: (FontSize: 14, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 32); Style: (FontSize: 11, Wrap: true, TextColor: #9298ae, HorizontalAlignment: Start, VerticalAlignment: Start); }
  }
  Group { Anchor: (Width: 4); }
  Label #StateLabel { Anchor: (Width: 72, Height: 30); Style: (FontSize: 10, TextColor: #62dcd5, HorizontalAlignment: End, VerticalAlignment: Center); }
  Group { Anchor: (Width: 6); }
  Group #ToggleFrame { Anchor: (Width: 38, Height: 20); LayoutMode: Full;
    Group #ToggleOff { Anchor: (Full: 0); Background: PatchStyle(TexturePath: "DapperMapGlassControl.png", Border: 8); LayoutMode: Left; Padding: (Full: 3); Group { Anchor: (Width: 14, Height: 14); Background: #74758e; } Group { FlexWeight: 1; } }
    Group #ToggleOn { Anchor: (Full: 0); Background: #4bcfc8(0.92); LayoutMode: Left; Padding: (Full: 3); Group { FlexWeight: 1; } Group { Anchor: (Width: 14, Height: 14); Background: #f1ffff; } }
    Group #BtnSlot { Anchor: (Full: 0); LayoutMode: Full; }
  }
}
