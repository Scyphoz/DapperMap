$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 760, Height: 760);

  #Title {
    Label #PageTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
        TextColor: #ff9566,
      );
      Padding: (Horizontal: 19);
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 18);

    Group #DapperMapHeader {
      Anchor: (Height: 76);
      Background: #2b1828(0.96);
      LayoutMode: Top;
      Padding: (Horizontal: 18, Vertical: 10);

      Label {
        Anchor: (Height: 18);
        Text: "SERVER CONTROL / DEFAULT PROFILE";
        Style: (FontSize: 10, RenderBold: true, TextColor: #ff9566, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #DapperMapTagline {
        Anchor: (Height: 34);
        Text: "Defaults applied to players without a saved profile.";
        Style: (FontSize: 15, TextColor: #fff0ea, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Group #DapperMapSettingsListContainer {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 12, Left: 4, Right: 4);

      Group #DapperMapSettingsList {
        LayoutMode: Top;
      }
    }

    Group #DapperMapResetFooter {
      Anchor: (Height: 62);
      LayoutMode: Left;
      Padding: (Top: 10, Bottom: 8);

      Group #DapperMapAdminButtonSlot {
        Anchor: (Width: 190, Height: 40);
        LayoutMode: CenterMiddle;
      }

      Group { FlexWeight: 1; }

      Group #DapperMapResetButtonSlot {
        Anchor: (Width: 260, Height: 40);
        LayoutMode: CenterMiddle;
      }
    }
  }
}

$C.@BackButton {}
