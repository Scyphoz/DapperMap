Group {
  Anchor: (Height: 62);
  Background: PatchStyle(TexturePath: "DapperMapGlassRow.png", Border: 10);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #5adbd3;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (FontSize: 14, RenderBold: true, TextColor: #f4f7fb, VerticalAlignment: Center);
    }
  }

  Group #MinusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Right: 4);
    LayoutMode: CenterMiddle;
  }

  Label #ValueLabel {
    Anchor: (Width: 138, Height: 38);
    Background: PatchStyle(TexturePath: "DapperMapGlassControl.png", Border: 9);
    Style: (FontSize: 14, RenderBold: true, TextColor: #f4c76b, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Group #PlusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Left: 4);
    LayoutMode: CenterMiddle;
  }
}
