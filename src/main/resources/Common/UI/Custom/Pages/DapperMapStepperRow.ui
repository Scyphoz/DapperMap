Group {
  Anchor: (Height: 64);
  Background: #16182b(0.94);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #57d8d0;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (FontSize: 15, RenderBold: true, TextColor: #f4f7fb, VerticalAlignment: Center);
    }
  }

  Group #MinusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Right: 4);
    LayoutMode: CenterMiddle;
  }

  Label #ValueLabel {
    Anchor: (Width: 138, Height: 38);
    Background: #24203d(0.94);
    Style: (FontSize: 14, RenderBold: true, TextColor: #f4c76b, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Group #PlusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Left: 4);
    LayoutMode: CenterMiddle;
  }
}
