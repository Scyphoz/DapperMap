Group {
  Anchor: (Height: 58);
  Background: #132331(0.96);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 4, Height: 42);
    Background: #9ddcff;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (FontSize: 15, RenderBold: true, TextColor: #f4f7fb, VerticalAlignment: Center);
    }
  }

  Group #MinusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Right: 4);
    LayoutMode: CenterMiddle;
  }

  Label #ValueLabel {
    Anchor: (Width: 138, Height: 38);
    Background: #0b1822(0.94);
    Style: (FontSize: 14, RenderBold: true, TextColor: #ffd66b, HorizontalAlignment: Center, VerticalAlignment: Center);
  }

  Group #PlusSlot {
    Anchor: (Width: 46, Height: 38);
    Padding: (Left: 4);
    LayoutMode: CenterMiddle;
  }
}
