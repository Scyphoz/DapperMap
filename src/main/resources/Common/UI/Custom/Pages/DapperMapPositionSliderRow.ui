$C = "../Common.ui";
// Same two columns as DapperMapDropdownRow.ui: the slider fills the control column, value on its right.
Group { Anchor: (Height: 64); LayoutMode: Left; Padding: (Left: 2, Right: 2, Vertical: 4);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { FlexWeight: 5; LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 24); Style: (FontSize: 14, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 28); Style: (FontSize: 11, Wrap: true, TextColor: #9298ae, HorizontalAlignment: Start, VerticalAlignment: Center); }
  }
  Group { Anchor: (Width: 12); }
  Group #ControlColumn { FlexWeight: 3; LayoutMode: Top;
    Group { FlexWeight: 1; }
    Group #Control { Anchor: (Height: 42); LayoutMode: Left;
      Group #SliderFrame { FlexWeight: 1; LayoutMode: Full;
        $C.@Slider #ValueSlider { @Anchor = (Full: 0); Min: 0; Max: 100; Step: 1; Value: 50; }
      }
      Label #ValueLabel { Anchor: (Left: 8, Width: 52, Height: 42); Text: "50%"; Style: (FontSize: 11, TextColor: #6fe8df, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
    Group { FlexWeight: 1; }
  }
}
