// Same two columns as DapperMapDropdownRow.ui; the disabled value box fills the control column.
Group { Anchor: (Height: 66); LayoutMode: Left; Padding: (Left: 2, Right: 2, Top: 6, Bottom: 6);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { FlexWeight: 5; LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 20); Style: (FontSize: 14, TextColor: #7f829a, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 32); Style: (FontSize: 11, Wrap: true, TextColor: #777d96, HorizontalAlignment: Start, VerticalAlignment: Start); }
  }
  Group { Anchor: (Width: 12); }
  Group #ControlColumn { FlexWeight: 3; LayoutMode: Top;
    Group { FlexWeight: 1; }
    Label #ValueLabel { Anchor: (Height: 34); Background: PatchStyle(TexturePath: "DapperMapGlassControl.png", Border: 9); Style: (FontSize: 9, TextColor: #777d96, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Group { FlexWeight: 1; }
  }
}
