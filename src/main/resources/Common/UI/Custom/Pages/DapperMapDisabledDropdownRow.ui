Group {
  Anchor: (Height: 62);
  Background: #151622(0.72);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #596174;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 23);
      Style: (FontSize: 14, RenderBold: true, TextColor: #8192a4, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 12, TextColor: #687b8e, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group {
    Anchor: (Width: 230, Height: 38);
    Background: #192632(0.96);
    Padding: (Horizontal: 10);
    Label #ValueLabel {
      Style: (FontSize: 13, TextColor: #8192a4, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }
}
