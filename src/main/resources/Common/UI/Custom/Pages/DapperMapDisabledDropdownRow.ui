Group { Anchor: (Height: 42); LayoutMode: Left; Padding: (Left: 2, Right: 2, Vertical: 4);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { Anchor: (Width: 180); LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 34); Style: (FontSize: 10, TextColor: #7f829a, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 0); Visible: false; }
  }
  Group { FlexWeight: 1; }
  Label #ValueLabel { Anchor: (Width: 170, Height: 34); Background: PatchStyle(TexturePath: "DapperMapGlassControl.png", Border: 9); Style: (FontSize: 9, TextColor: #777d96, HorizontalAlignment: Center, VerticalAlignment: Center); }
}
