$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 700, Height: 760);

  #Title {
    Label #PageTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
        TextColor: #ffd66b,
      );
      Padding: (Horizontal: 19);
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 14);

    Group #DapperMapHeader {
      Anchor: (Height: 60);
      Background: #0b1822(0.96);
      Padding: (Horizontal: 16, Vertical: 10);

      Label #DapperMapTagline {
        Anchor: (Height: 40);
        Text: "A lightweight and sophisticated Minimap mod";
        Style: (FontSize: 15, TextColor: #d9eefc, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Group #DapperMapSettingsListContainer {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 10, Left: 8, Right: 8);

      Group #DapperMapSettingsList {
        LayoutMode: Top;
      }
    }

    Group #DapperMapResetFooter {
      Anchor: (Height: 62);
      LayoutMode: CenterMiddle;
      Padding: (Top: 10, Bottom: 8);

      Group #DapperMapResetButtonSlot {
        Anchor: (Width: 260, Height: 40);
        LayoutMode: CenterMiddle;
      }
    }
  }
}

$C.@BackButton {}
