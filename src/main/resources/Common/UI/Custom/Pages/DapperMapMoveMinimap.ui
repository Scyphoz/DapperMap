      }
    }

    Group #MoveFineTuneList {
      Anchor: (Height: 116);
      LayoutMode: Top;
    }

    Group #MoveMinimapFooter {
      Anchor: (Height: 58);
      LayoutMode: Left;
      Padding: (Top: 10, Bottom: 8, Horizontal: 100);

      Group #MoveMinimapSaveSlot {
        FlexWeight: 1;
        Anchor: (Height: 40);
