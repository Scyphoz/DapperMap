$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 820, Height: 720);

  #Title {
    Label #MoveMinimapTitle {
      Text: "Move Minimap";
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
        TextColor: #ffd66b,
      );
      Padding: (Horizontal: 19);
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 14);

    Group #MoveMinimapHeader {
      Anchor: (Height: 82);
      Background: #0b1822(0.96);
      LayoutMode: Top;
      Padding: (Horizontal: 16, Vertical: 10);

      Label #MoveMinimapHint {
        Anchor: (Height: 20);
        Text: "Choose a grid position, then fine-tune below. Save to apply your changes.";
        Style: (
          FontSize: 13,
          TextColor: #d9eefc,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #MoveMinimapPosition {
        Anchor: (Height: 26);
        Style: (
          FontSize: 15,
          RenderBold: true,
          TextColor: #9ddcff,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label #MovePreviewDescription {
        Anchor: (Height: 18);
        Style: (
          FontSize: 11,
          TextColor: #cfe0ef,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }
    }

    Group #MovePreviewArea {
      Anchor: (Height: 360);
      Background: #071016(0.82);
      Padding: (Horizontal: 10, Vertical: 10);

      Group #MovePreviewCanvas {
        Anchor: (Full: 0);
      }

      Group #MovePreviewClickGrid {
        Anchor: (Full: 0);
        LayoutMode: Top;

