$C = "../Common.ui";

Group {
  Anchor: (Height: 64);
  Background: #16182b(0.94);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #57d8d0;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f2ff,
        VerticalAlignment: Center
      );
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;

    DropdownEntry {
      Value: "0";
      Text: "Top left";
    }
    DropdownEntry {
      Value: "1";
      Text: "Top right";
    }
    DropdownEntry {
      Value: "2";
      Text: "Bottom left";
    }
    DropdownEntry {
      Value: "3";
      Text: "Bottom right";
    }
  }
}
