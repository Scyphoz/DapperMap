$C = "../Common.ui";
Group {
  Anchor: (Height: 50);
  LayoutMode: Left;
  Background: PatchStyle(TexturePath: "DapperMapGlassRow.png", Border: 10);
  Padding: (Horizontal: 12, Vertical: 6);
  Label #RowLabel {
    FlexWeight: 1;
    Style: (FontSize: 14, RenderBold: true, TextColor: #d9d0f5, HorizontalAlignment: Start, VerticalAlignment: Center);
  }
  $C.@Slider #ValueSlider {
    @Anchor = (Width: 400, Height: 38);
    Min: 0; Max: 255; Step: 1; Value: 0;
  }
  Label #ValueLabel {
    Anchor: (Width: 55, Height: 38);
    Style: (FontSize: 14, RenderBold: true, TextColor: #6fe8df, HorizontalAlignment: Center, VerticalAlignment: Center);
  }
}
