$C = "../Common.ui";

Group {
  Anchor: (Height: 62);
  Background: PatchStyle(TexturePath: "DapperMapGlassRow.png", Border: 10);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #5adbd3;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 14, Right: 10);

    Label #RowLabel {
      Anchor: (Height: 23);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #d9d0f5,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 10, TextColor: #9997b1, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #Control {
    Anchor: (Width: 250, Height: 38);
    LayoutMode: Left;

    $C.@Slider #ValueSlider {
      @Anchor = (Width: 190, Height: 38);
      Min: 0;
      Max: 100;
      Step: 1;
      Value: 50;
    }

    Label #ValueLabel {
      Anchor: (Left: 8, Width: 52, Height: 38);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #6fe8df,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
      Text: "50%";
    }
  }
}
