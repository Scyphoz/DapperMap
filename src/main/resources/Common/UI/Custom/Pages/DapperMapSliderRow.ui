$C = "../Common.ui";

Group {
  Anchor: (Height: 58);
  Background: #132331(0.96);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 4, Height: 42);
    Background: #9ddcff;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 23);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f7fb,
        HorizontalAlignment: Start,
        VerticalAlignment: Center
      );
    }

    Label #RowDescription {
      Anchor: (Height: 19);
      Style: (FontSize: 11, TextColor: #9ddcff, HorizontalAlignment: Start, VerticalAlignment: Center);
    }
  }

  Group #Control {
    Anchor: (Width: 250, Height: 38);
    LayoutMode: Left;

    $C.@Slider #ValueSlider {
      @Anchor = (Width: 190, Height: 38);
      Min: 0;
      Max: 100;
      Step: 1;
      Value: 50;
    }

    Label #ValueLabel {
      Anchor: (Left: 8, Width: 52, Height: 38);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #9ddcff,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
      Text: "50%";
    }
  }
}
