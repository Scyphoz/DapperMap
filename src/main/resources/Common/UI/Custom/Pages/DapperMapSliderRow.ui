$C = "../Common.ui";
Group { Anchor: (Height: 52); LayoutMode: Left; Padding: (Left: 2, Right: 2, Vertical: 5);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { Anchor: (Width: 135); LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 42); Style: (FontSize: 10, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 0); Visible: false; }
  }
  Group { FlexWeight: 1; }
  Group #Control { Anchor: (Width: 220, Height: 42); LayoutMode: Left;
    $C.@Slider #ValueSlider { @Anchor = (Width: 160, Height: 42); Min: 0; Max: 100; Step: 1; Value: 50; }
    Label #ValueLabel { Anchor: (Left: 8, Width: 52, Height: 42); Text: "50%"; Style: (FontSize: 11, TextColor: #6fe8df, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
}
