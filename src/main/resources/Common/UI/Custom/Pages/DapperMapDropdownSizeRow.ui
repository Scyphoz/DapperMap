$C = "../Common.ui";

Group {
  Anchor: (Height: 58);
  Background: #132331(0.96);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 4, Height: 42);
    Background: #9ddcff;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f7fb,
        VerticalAlignment: Center
      );
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;

    DropdownEntry {
      Value: "120";
      Text: "120 px";
    }
    DropdownEntry {
      Value: "140";
      Text: "140 px";
    }
    DropdownEntry {
      Value: "160";
      Text: "160 px";
    }
    DropdownEntry {
      Value: "180";
      Text: "180 px";
    }
    DropdownEntry {
      Value: "200";
      Text: "200 px";
    }
    DropdownEntry {
      Value: "220";
      Text: "220 px";
    }
    DropdownEntry {
      Value: "240";
      Text: "240 px";
    }
    DropdownEntry {
      Value: "260";
      Text: "260 px";
    }
    DropdownEntry {
      Value: "280";
      Text: "280 px";
    }
    DropdownEntry {
      Value: "300";
      Text: "300 px";
    }
    DropdownEntry {
      Value: "320";
      Text: "320 px";
    }
    DropdownEntry {
      Value: "340";
      Text: "340 px";
    }
    DropdownEntry {
      Value: "360";
      Text: "360 px";
    }
  }
}
