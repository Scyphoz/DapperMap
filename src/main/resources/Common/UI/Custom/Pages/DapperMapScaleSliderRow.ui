$C = "../Common.ui";
Group { Anchor: (Height: 64); LayoutMode: Left; Padding: (Left: 2, Right: 2, Vertical: 4);
  Group #Accent { Anchor: (Width: 0); Visible: false; }
  Group #Info { FlexWeight: 1; LayoutMode: Top;
    Label #RowLabel { Anchor: (Height: 24); Style: (FontSize: 14, TextColor: #cdc7e6, HorizontalAlignment: Start, VerticalAlignment: Center); }
    Label #RowDescription { Anchor: (Height: 28); Style: (FontSize: 11, Wrap: true, TextColor: #9298ae, HorizontalAlignment: Start, VerticalAlignment: Center); }
  }
  Group { Anchor: (Width: 4); }
  // Size value on the left, then the slider. Stops 0..10 (the server maps each to a percentage; stop 5, the middle, is 100%).
  Group #Control { Anchor: (Width: 220, Height: 42); LayoutMode: Left;
    Label #ValueLabel { Anchor: (Width: 52, Height: 42); Text: "100%"; Style: (FontSize: 11, TextColor: #6fe8df, HorizontalAlignment: End, VerticalAlignment: Center); }
    Group { Anchor: (Width: 8); }
    $C.@Slider #ValueSlider { @Anchor = (Width: 160, Height: 42); Min: 0; Max: 10; Step: 1; Value: 5; }
  }
}
