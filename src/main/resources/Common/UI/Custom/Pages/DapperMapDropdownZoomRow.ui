$C = "../Common.ui";

Group {
  Anchor: (Height: 64);
  Background: #16182b(0.94);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #57d8d0;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: #f4f2ff,
        VerticalAlignment: Center
      );
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;

    DropdownEntry {
      Value: "16";
      Text: "16 blocks";
    }
    DropdownEntry {
      Value: "32";
      Text: "32 blocks";
    }
    DropdownEntry {
      Value: "48";
      Text: "48 blocks";
    }
    DropdownEntry {
      Value: "64";
      Text: "64 blocks";
    }
    DropdownEntry {
      Value: "80";
      Text: "80 blocks";
    }
    DropdownEntry {
      Value: "96";
      Text: "96 blocks";
    }
    DropdownEntry {
      Value: "112";
      Text: "112 blocks";
    }
    DropdownEntry {
      Value: "128";
      Text: "128 blocks";
    }
    DropdownEntry {
      Value: "144";
      Text: "144 blocks";
    }
    DropdownEntry {
      Value: "160";
      Text: "160 blocks";
    }
    DropdownEntry {
      Value: "176";
      Text: "176 blocks";
    }
    DropdownEntry {
      Value: "192";
      Text: "192 blocks";
    }
    DropdownEntry {
      Value: "208";
      Text: "208 blocks";
    }
    DropdownEntry {
      Value: "224";
      Text: "224 blocks";
    }
    DropdownEntry {
      Value: "240";
      Text: "240 blocks";
    }
    DropdownEntry {
      Value: "256";
      Text: "256 blocks";
    }
  }
}
