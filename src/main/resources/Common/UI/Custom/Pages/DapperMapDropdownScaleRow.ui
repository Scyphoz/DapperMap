$C = "../Common.ui";

Group {
  Anchor: (Height: 62);
  Background: PatchStyle(TexturePath: "DapperMapGlassRow.png", Border: 10);
  LayoutMode: Left;
  Padding: (Horizontal: 12, Vertical: 7);

  Group #Accent {
    Anchor: (Width: 7, Height: 7);
    Background: #5adbd3;
  }

  Group #Info {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Padding: (Left: 12, Right: 8);

    Label #RowLabel {
      Anchor: (Height: 36);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #d9d0f5,
        VerticalAlignment: Center
      );
    }
  }

  $C.@DropdownBox #ValueDropdown {
    @Anchor = (Width: 230, Height: 38);
    ShowLabel: true;

    DropdownEntry {
      Value: "75";
      Text: "75%";
    }
    DropdownEntry {
      Value: "85";
      Text: "85%";
    }
    DropdownEntry {
      Value: "100";
      Text: "100%";
    }
    DropdownEntry {
      Value: "110";
      Text: "110%";
    }
    DropdownEntry {
      Value: "125";
      Text: "125%";
    }
    DropdownEntry {
      Value: "140";
      Text: "140%";
    }
    DropdownEntry {
      Value: "160";
      Text: "160%";
    }
  }
}
